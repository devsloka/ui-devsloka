{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "footer-block",
  "type": "registry:block",
  "title": "Footer Block",
  "description": "A Footer Block component for displaying a footer section.",
  "files": [
    {
      "path": "src/registry/blocks/footer-block.tsx",
      "type": "registry:block",
      "content": "import React from \"react\";\nimport { Input } from \"@/components/ui/input\";\nimport { Button } from \"@/components/ui/button\";\nimport { Facebook, Instagram, Linkedin, Twitter } from \"lucide-react\";\n\nconst FooterBlock = () => {\n  return (\n    <div>\n      <footer className=\"relative overflow-hidden\">\n        {/* Gradient background */}\n        <div className=\"absolute inset-0 bg-gradient-to-r from-primary/20 to-primary/5 dark:from-primary/10 dark:to-background pointer-events-none\" />\n\n        <div className=\"container mx-auto relative z-10 px-5\">\n          <div className=\"grid grid-cols-1 md:grid-cols-12 gap-8 py-12\">\n            {/* Brand section */}\n            <div className=\"md:col-span-4 space-y-4\">\n              <div className=\"flex items-center space-x-2\">\n                <div className=\"h-8 w-8 rounded-full bg-primary\" />\n                <span className=\"text-2xl font-bold\">Brand</span>\n              </div>\n              <p className=\"text-muted-foreground\">\n                Creating beautiful digital experiences that inspire and connect\n                people around the world.\n              </p>\n              <div className=\"flex space-x-4\">\n                <Button\n                  size=\"icon\"\n                  variant=\"ghost\"\n                  className=\"rounded-full h-9 w-9\"\n                >\n                  <Facebook className=\"h-4 w-4\" />\n                  <span className=\"sr-only\">Facebook</span>\n                </Button>\n                <Button\n                  size=\"icon\"\n                  variant=\"ghost\"\n                  className=\"rounded-full h-9 w-9\"\n                >\n                  <Twitter className=\"h-4 w-4\" />\n                  <span className=\"sr-only\">Twitter</span>\n                </Button>\n                <Button\n                  size=\"icon\"\n                  variant=\"ghost\"\n                  className=\"rounded-full h-9 w-9\"\n                >\n                  <Instagram className=\"h-4 w-4\" />\n                  <span className=\"sr-only\">Instagram</span>\n                </Button>\n                <Button\n                  size=\"icon\"\n                  variant=\"ghost\"\n                  className=\"rounded-full h-9 w-9\"\n                >\n                  <Linkedin className=\"h-4 w-4\" />\n                  <span className=\"sr-only\">LinkedIn</span>\n                </Button>\n              </div>\n            </div>\n\n            {/* Links section */}\n            <div className=\"md:col-span-2 space-y-4\">\n              <h3 className=\"font-semibold\">Company</h3>\n              <ul className=\"space-y-2\">\n                <li>\n                  <a\n                    href=\"#\"\n                    className=\"text-muted-foreground hover:text-foreground transition-colors\"\n                  >\n                    About\n                  </a>\n                </li>\n                <li>\n                  <a\n                    href=\"#\"\n                    className=\"text-muted-foreground hover:text-foreground transition-colors\"\n                  >\n                    Careers\n                  </a>\n                </li>\n                <li>\n                  <a\n                    href=\"#\"\n                    className=\"text-muted-foreground hover:text-foreground transition-colors\"\n                  >\n                    Blog\n                  </a>\n                </li>\n                <li>\n                  <a\n                    href=\"#\"\n                    className=\"text-muted-foreground hover:text-foreground transition-colors\"\n                  >\n                    Press\n                  </a>\n                </li>\n              </ul>\n            </div>\n\n            <div className=\"md:col-span-2 space-y-4\">\n              <h3 className=\"font-semibold\">Resources</h3>\n              <ul className=\"space-y-2\">\n                <li>\n                  <a\n                    href=\"#\"\n                    className=\"text-muted-foreground hover:text-foreground transition-colors\"\n                  >\n                    Documentation\n                  </a>\n                </li>\n                <li>\n                  <a\n                    href=\"#\"\n                    className=\"text-muted-foreground hover:text-foreground transition-colors\"\n                  >\n                    Help Center\n                  </a>\n                </li>\n                <li>\n                  <a\n                    href=\"#\"\n                    className=\"text-muted-foreground hover:text-foreground transition-colors\"\n                  >\n                    Guides\n                  </a>\n                </li>\n                <li>\n                  <a\n                    href=\"#\"\n                    className=\"text-muted-foreground hover:text-foreground transition-colors\"\n                  >\n                    API\n                  </a>\n                </li>\n              </ul>\n            </div>\n\n            {/* Newsletter section */}\n            <div className=\"md:col-span-4 space-y-4\">\n              <h3 className=\"font-semibold\">Subscribe to our newsletter</h3>\n              <p className=\"text-muted-foreground\">\n                Get the latest updates and news right at your inbox.\n              </p>\n              <div className=\"flex space-x-2\">\n                <Input\n                  type=\"email\"\n                  placeholder=\"Enter your email\"\n                  className=\"rounded-full\"\n                />\n                <Button className=\"rounded-full\">Subscribe</Button>\n              </div>\n            </div>\n          </div>\n\n          {/* Bottom section */}\n          <div className=\"border-t py-6 flex flex-col md:flex-row justify-between items-center space-y-4 md:space-y-0\">\n            <div className=\"text-sm text-muted-foreground\">\n              © {new Date().getFullYear()} Brand. All rights reserved.\n            </div>\n            <div className=\"flex space-x-6 text-sm\">\n              <a\n                href=\"#\"\n                className=\"text-muted-foreground hover:text-foreground transition-colors\"\n              >\n                Privacy Policy\n              </a>\n              <a\n                href=\"#\"\n                className=\"text-muted-foreground hover:text-foreground transition-colors\"\n              >\n                Terms of Service\n              </a>\n              <a\n                href=\"#\"\n                className=\"text-muted-foreground hover:text-foreground transition-colors\"\n              >\n                Cookies\n              </a>\n            </div>\n          </div>\n        </div>\n      </footer>\n    </div>\n  );\n};\n\nexport default FooterBlock;\n"
    }
  ],
  "dependencies": [
    "lucide-react"
  ],
  "registryDependencies": [
    "button",
    "input"
  ]
}
